{
  "name": "case-closed-ai",
  "version": "0.2.0",
  "private": true,
  "description": "Case Closed AI Windows desktop device diagnostics with detective-style guided investigations",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "test": "node --test test/*.test.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ai.caseclosed.review",
    "productName": "Case Closed AI",
    "files": [
      "index.html",
      "desktop/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "artifactName": "CaseClosedAI-${version}-Setup.${ext}",
    "publish": null
  },
  "author": "Case Closed AI contributors"
}
