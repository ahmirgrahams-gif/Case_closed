{
  "name": "case-closed-ai",
  "version": "0.3.0",
  "private": true,
  "description": "Case Closed AI branded Windows desktop investigator with real device diagnostics",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "electron .",
    "build:win": "npm run icons && electron-builder --win nsis --x64 --publish never",
    "test": "node --test test/*.test.cjs",
    "icons": "node scripts/generate-icon.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "ai.caseclosed.desktop",
    "productName": "Case Closed AI",
    "files": [
      "index.html",
      "desktop/**/*",
      "assets/**/*",
      "package.json",
      "!assets/*.ico",
      "!assets/*.png"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "assets/case-closed.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Case Closed AI",
      "installerIcon": "assets/case-closed.ico",
      "uninstallerIcon": "assets/case-closed.ico"
    },
    "artifactName": "CaseClosedAI-${version}-Setup.${ext}",
    "publish": null,
    "extraResources": [
      {
        "from": "assets/case-closed.ico",
        "to": "case-closed.ico"
      }
    ],
    "extraMetadata": {}
  },
  "author": "Case Closed AI contributors"
}
